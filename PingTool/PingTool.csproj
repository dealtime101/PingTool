<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- THE version of PingTool: bump it by hand at each delivery (see pingtool-deploy.sh).
         1.0.0 = the repository as first received; 1.1.0 = after audits 451-453 (+ version system);
         1.2.0 = recent-window percentiles and jitter (PIN453.5);
         1.3.0 = TCP, HTTP and DNS probes besides ping (PIN453.6);
         1.4.0 = named monitoring profiles (PIN453.7);
         1.5.0 = network path captured at each outage (PIN453.8);
         1.5.1 = status 11004 no longer reported as "refused" (PIN453.17);
         1.5.2 = reassembly timeout no longer reported as an expired TTL (PIN453.16);
         1.5.3 = loaded settings are validated: numbers in range, clean lists (PIN453.14);
         1.5.4 = isolated successful pings are drawn on the graph (PIN453.11);
         1.5.5 = the numeric boxes are named for screen readers (PIN453.12);
         1.6.0 = the "slow" and "loss" alert thresholds are set in the window (PIN454.1);
         1.7.0 = timeline of the whole session, with a time axis (PIN454.2);
         1.7.1 = source quench no longer blamed on the destination (PIN454.5);
         1.7.2 = CSV formula protection looks at the first visible character (PIN454.6);
         1.7.3 = the screen leaves "Running" at once when every loop died (PIN454.4);
         1.8.0 = failures before "down" are set in the window, and "back up" says how long the outage lasted (PIN456.2);
         1.8.1 = the incident summary names the longest outage (PIN456.3);
         1.9.0 = optional automatic log: every ping appended to a daily CSV per host (PIN456.4);
         1.9.1 = the recent picture also shows the loss over the last 60 pings (PIN456.6);
         1.10.0 = trace route on demand from the host list, and route text shown on separate lines (PIN456.7);
         1.11.0 = command line: targets, start, minimized and interval options (PIN456.8);
         1.12.0 = profiles can be exported to a file and imported from one (PIN456.9);
         1.12.1 = export and timeline say when the log let its oldest pings go (PIN456.27);
         1.12.2 = the "Stopped" hint no longer survives a restart (PIN456.10);
         1.12.3 = full and compact window sizes follow the screen scaling (PIN456.12);
         1.12.4 = the notification icon goes away after its balloon (PIN456.13);
         1.12.5 = probes start one interval apart, whatever the answer took (PIN456.14);
         1.12.6 = the empty-address message says what to do (PIN456.15). -->
    <Version>1.12.6</Version>
  </PropertyGroup>

</Project>